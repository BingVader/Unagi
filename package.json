{
  "name": "unagi",
  "displayName": "UNAGI - Sprints, Tasks, Notes & Focus",
  "description": "Achieve total workflow awareness: track active sprints, checklists, reminders, scratchpad notes, and focus timer directly in your sidebar.",
  "version": "2.2.0",
  "publisher": "pixel-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/vscode-unagi"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Productivity"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "unagi-container",
          "title": "UNAGI",
          "icon": "media/companion-icon.svg"
        }
      ]
    },
    "views": {
      "unagi-container": [
        {
          "type": "webview",
          "id": "unagi.view",
          "name": "UNAGI: Total Awareness",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "unagi.focus",
        "title": "UNAGI: Open Sprints, Notes & Timer",
        "category": "UNAGI"
      },
      {
        "command": "unagi.addTask",
        "title": "UNAGI: Quick Add Sprint Task",
        "category": "UNAGI",
        "icon": "$(plus)"
      },
      {
        "command": "unagi.toggleTimer",
        "title": "UNAGI: Start / Pause Focus Timer",
        "category": "UNAGI",
        "icon": "$(clock)"
      }
    ],
    "configuration": {
      "title": "UNAGI",
      "properties": {
        "unagi.focusMinutes": {
          "type": "number",
          "default": 25,
          "minimum": 5,
          "maximum": 120,
          "description": "Focus timer duration in minutes."
        },
        "unagi.reminderIntervalMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 120,
          "description": "Interval (in minutes) for checking pending high-priority sprint task reminders."
        },
        "unagi.enableTaskReminders": {
          "type": "boolean",
          "default": true,
          "description": "Enable periodic notification reminders for pending sprint tasks."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
